Context()->variables->add(y=>'Real');
$ddyddx=Formula("sin^2(x)sec^2(y)tan(y)+cos(x)sec(y)");
@y=(random(0,3.14,0.01),random(0,3.14,0.01),random(0,3.14,0.01),random(0,3.14,0.01),random(0,3.14,0.01));
@x=map{acos(1-sin($_))}(@y);
@xy=map{[$x[$_],$y[$_]]}(0..4);
$ddyddx->{test_points}=~~@xy;

############################################################
# Body
############################################################

BEGIN_PGML
An implicitly defined function is given. Find [`\lzn{2}{y}{x}\text{.}`] Note: these are the same functions used in Exercises 13 through 16.

[`\cos(x)+\sin(y)=1`]

[_]{$ddyddx}{50}

END_PGML

