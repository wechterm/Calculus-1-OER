);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());

############################################################
# PG Setup Code
############################################################
$fname = list_random('f','g','h','j','k','p','m');
$x = list_random('q','r','t','x','y','z','w');
$a = non_zero_random(-9,9,1);
if($envir{problemSeed}==1){$fname='g';$x='x';$a=7;};
Context()->variables->are($x=>'Real');
Context()->variables->set($x=>{limits=>[0,4]});
$f = Formula("($x+$a)/sqrt($x)");
$fp = $f->D($x);

############################################################
# Body
############################################################

BEGIN_PGML
Compute the derivative of the given function.

[`[$fname]([$x])=[$f]`]

[@KeyboardInstructions('To enter [`\sqrt{x}\text{,}`] type [|sqrt(x)|]*.')@]**

[_]{$fp}{80}

END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
