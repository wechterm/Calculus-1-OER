DOCUMENT();

############################################################
# Load Macros
############################################################
loadMacros(
  "PGstandard.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PCCmacros.pl",
  "parserRoot.pl",
  "contextForm.pl",
  "contextFraction.pl",
  "PGcourse.pl",
);
COMMENT('Authored in PreTeXt');

############################################################
# Header
############################################################
TEXT(beginproblem());

############################################################
# PG Setup Code
############################################################
$fname = list_random('f','g','h','j','k','p','m');
$x = list_random('q','r','t','x','y','z','w');
$pm = list_random('+','-');
$n = random(3,6,1);
if($envir{problemSeed}==1){$fname='f';$x='x';$pm='+';$n=3;};
Context("Fraction");
parser::Root->Enable;
Context()->variables->are($x=>'Real');
Context()->variables->set($x=>{limits=>[0,4]});
$f = Formula("root($n,$x) $pm $x^(($n-1)/$n)");
$fp = $f->D($x);

############################################################
# Body
############################################################

BEGIN_PGML
Compute the derivative of the given function.

[`[$fname]([$x])=[$f]`]

[@KeyboardInstructions('To enter [`\sqrt{x}\text{,}`] type [|sqrt(x)|]*. To enter [`\sqrt[n]{x}\text{,}`] type [|root(n,x)|]*.')@]**

[_]{$fp}{80}

END_PGML

############################################################
# End Problem
############################################################

ENDDOCUMENT();
