Context()->variables->add(y=>'Real');
$ddyddx=Formula("-((2y+1)(12x^2)-4x^3(2*-(4x^3)/(2y+1)))/(2y+1)^2");
@y=(random(-2,2,0.1),random(-2,2,0.1),random(-2,2,0.1),random(-2,2,0.1),random(-2,2,0.1));
@x=map{(7-($_)-($_)**2)**(1/4)*(-1)**(random(-1,1,2))}(@y);
@xy=map{[$x[$_],$y[$_]]}(0..4);
$ddyddx->{test_points}=~~@xy;

############################################################
# Body
############################################################

BEGIN_PGML
An implicitly defined function is given. Find [`\lzn{2}{y}{x}\text{.}`] Note: these are the same functions used in Exercises 13 through 16.

[`x^4+y^2+y=7`]

[_]{$ddyddx}{50}

END_PGML

