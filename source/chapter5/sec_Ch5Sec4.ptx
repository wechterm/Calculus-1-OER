          <cell>Time (hr)</cell>
          <cell>Speed (mph)</cell>
        </row>
        <row>
          <cell><m>0</m> (start)</cell>
          <cell><m>50</m></cell>
        </row>
        <row>
          <cell><m>1</m></cell>
          <cell><m>40</m></cell>
        </row>
        <row>
          <cell><m>2</m></cell>
          <cell><m>50</m></cell>
        </row>
        <row>
          <cell><m>3</m></cell>
          <cell><m>60</m></cell>
        </row>
      </tabular>
      <image source="ch5/CNX_Calc_Figure_05_04_207.jpg" width="50%">
