      <tabular halign="center">
        <col/>
        <col/>
        <row header="yes" bottom="minor">
          <cell>Hours Past Midnight</cell>
          <cell>No. of Burgers Sold</cell>
        </row>
        <row>
          <cell><m>9</m></cell>
          <cell><m>3</m></cell>
        </row>
        <row>
          <cell><m>12</m></cell>
          <cell><m>28</m></cell>
        </row>
        <row>
          <cell><m>15</m></cell>
          <cell><m>20</m></cell>
        </row>
        <row>
          <cell><m>18</m></cell>
          <cell><m>30</m></cell>
        </row>
        <row>
          <cell><m>21</m></cell>
          <cell><m>45</m></cell>
        </row>
      </tabular>
      <image source="ch5/CNX_Calc_Figure_05_04_209.jpg" width="50%">
